# =============================================================================
# flutter_practice - configuration template
#
#   1. Copy this file to `.env`      (cp .env.example .env)
#   2. Fill in your values.
#   3. `.env` is git-ignored, so real secrets never reach the repository.
#
# PRECEDENCE - the app resolves every key in this order:
#   1. --dart-define   (compile-time flag, wins for CI / release builds)
#   2. `.env`          (this file, wins for local development)
#   3. Built-in default (dev fallback so the app always starts)
#
# `--dart-define` examples:
#   flutter run \
#     --dart-define=API_BASE_URL=http://192.168.1.5:8000 \
#     --dart-define=KHALTI_PUBLIC_KEY=test_public_key_xxxxx
#
# All keys below are OPTIONAL. Anything you leave out falls back to the
# built-in default, so a fresh checkout still runs.
# =============================================================================

# --- Backend ----------------------------------------------------------------
# Your Flask/Django API that serves GET /vehicles.
API_BASE_URL=http://192.168.18.17:8000

# --- Khalti (https://khalti.com/epay -> Dashboard -> API keys) ----------------
# Leave empty to disable Khalti at runtime; the payment screen will show a
# clear "not configured" message instead of failing obscurely.
KHALTI_PUBLIC_KEY=
# Override only if you proxy /payment/initialize/ through your own server.
KHALTI_BASE_URL=https://aapi.khalti.com/api/v2

# --- eSewa (https://merchant.esewa.com.np -> integrations) -------------------
# The value below is eSewa's publicly documented RC/test secret; the app uses
# it as the default so the test flow works out of the box.
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
# EPAYTEST is eSewa's built-in RC product code; only set this for live.
ESEWA_PRODUCT_CODE=EPAYTEST
# true = RC/test gateway, false = production gateway
ESEWA_USE_DEV_MODE=true

# --- Facebook Login (https://developers.facebook.com/apps/) ------------------
# Must match android/app/src/main/res/values/strings.xml or Facebook login
# will be rejected at runtime.
FACEBOOK_APP_ID=
FACEBOOK_CLIENT_TOKEN=

# --- Local development switches ---------------------------------------------
# true = LogInterceptor prints every response body. NEVER enable in release.
ENABLE_HTTP_LOGGING=true
